[Unit]
Description=Choose power profile from charger and battery level
After=power-profiles-daemon.service
Wants=power-profiles-daemon.service

[Service]
Type=oneshot
# Transient account for this run. Polkit allows only this name to switch profiles.
DynamicUser=yes
User=power-profile-auto
ExecStart=/usr/local/sbin/power-profile-auto update

[Install]
WantedBy=multi-user.target
