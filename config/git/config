[core]
	pager = delta

[interactive]
  diffFilter = delta --color-only

[pager]
	blame = delta

[init]
	defaultBranch = main

[pull]
	rebase = true

[merge]
  conflictstyle = zdiff3

[delta]
  navigate = true
  dark = true
  side-by-side = true
  line-numbers = true
  hyperlinks = true
  syntax-theme = Catppuccin Mocha

[commit]
  gpgsign = true

[tag]
  gpgsign = true

NOTE: add user details (after installation)
